{
  "name": "asset-lookout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "bun run server/index.ts",
    "server:dev": "bun --watch run server/index.ts",
    "dev:all": "concurrently \"bun run server\" \"bun run dev\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "elysia": "^1.4.30",
    "firebase": "^12.19.0",
    "lightweight-charts": "^5.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.5",
    "oxlint": "^1.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0"
  }
}
