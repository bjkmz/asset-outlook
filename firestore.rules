rules_version = '2';
service cloud.firestore {
  function isOwner(userId) {
    return request.auth != null && request.auth.uid == userId;
  }

  function validWatchlist() {
    return request.resource.data.keys().hasOnly(['name', 'symbols', 'updatedAt'])
      && request.resource.data.name is string
      && request.resource.data.name.size() >= 1
      && request.resource.data.name.size() <= 80
      && request.resource.data.symbols is list
      && request.resource.data.symbols.size() <= 45;
  }

  match /databases/{database}/documents {
    match /users/{userId}/watchlists/default {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validWatchlist();
      allow delete: if isOwner(userId);
    }
    match /users/{userId}/{other=**} {
      allow read, write: if false;
    }
  }
}
